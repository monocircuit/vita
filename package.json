{
  "name": "vita",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Use pnpm for this project.'); process.exit(1);}\"",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:cpu": "next dev --experimental-cpu-prof",
    "build:debug": "next build --webpack -d --experimental-debug-memory-usage",
    "build:cpu": "next build --webpack --experimental-cpu-prof",
    "build": "next build",
    "build:electron": "tsc --project electron/tsconfig.json",
    "start": "next start",
    "start:electron": "electron .",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c blue,green \"pnpm vite:dev\" \"wait-on http://localhost:5173 && pnpm build:electron && pnpm start:electron\"",
    "dist:test": "pnpm build:electron && electron-builder --dir",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/roboto": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@monocircuit/monolithium": "^1.0.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/styled-engine-sc": "^7.3.6",
    "@pixi/react": "^8.0.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-form": "^1.27.4",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.170.8",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "^12.10.0",
    "classnames": "^2.5.1",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.14.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-merge-refs": "^3.0.2",
    "styled-components": "^6.1.19",
    "swr": "^2.3.8",
    "text-to-svg": "^3.1.5",
    "tree-model": "^1.0.7",
    "two.js": "^0.8.22",
    "use-state-with-callback": "^3.0.2",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.0.14",
    "winston": "^3.19.0",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/text-to-svg": "^3.1.4",
    "@types/two.js": "^0.7.9",
    "@types/wait-on": "^5.3.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.11",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "immer": "^11.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "sass": "^1.96.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^8.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "sharp",
      "unrs-resolver"
    ]
  }
}
